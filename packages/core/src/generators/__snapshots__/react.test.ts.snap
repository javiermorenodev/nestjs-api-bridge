  }, [refetch]);

  return { data, loading, error, refetch };
}

export function useUsersFindOne(id: string) {
  type Result = Awaited<ReturnType<typeof service.findOne>>;
  const [data, setData] = useState<Result | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<Error | null>(null);

  const refetch = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const result = await service.findOne(id);
      setData(result);
      return result;
    } catch (cause) {
      const failure = cause instanceof Error ? cause : new Error(String(cause));
      setError(failure);
      throw failure;
    } finally {
      setLoading(false);
    }
  }, [id]);

  useEffect(() => {
    void refetch().catch(() => undefined);
  }, [refetch]);

  return { data, loading, error, refetch };
}

export function useUsersSearch(q?: string) {
  type Result = Awaited<ReturnType<typeof service.search>>;
  const [data, setData] = useState<Result | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<Error | null>(null);

  const refetch = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const result = await service.search(q);
      setData(result);
      return result;
    } catch (cause) {
      const failure = cause instanceof Error ? cause : new Error(String(cause));
      setError(failure);
      throw failure;
    } finally {
      setLoading(false);
    }
  }, [q]);

  useEffect(() => {
    void refetch().catch(() => undefined);
  }, [refetch]);

  return { data, loading, error, refetch };
}

export function useUsersCreate() {
  type Result = Awaited<ReturnType<typeof service.create>>;
  const [data, setData] = useState<Result | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<Error | null>(null);

  const mutate = useCallback(async (...args: Parameters<typeof service.create>) => {
    setLoading(true);
    setError(null);
    try {
      const result = await service.create(...args);
      setData(result);
      return result;
    } catch (cause) {
      const failure = cause instanceof Error ? cause : new Error(String(cause));
      setError(failure);
      throw failure;
    } finally {
      setLoading(false);
    }
  }, []);

  return { mutate, data, loading, error };
}

