{
  "name": "@nestjs-api-bridge/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && mkdir -p dist/generators/templates && cp src/generators/templates/*.hbs dist/generators/templates/",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "glob": "^11.1.0",
    "handlebars": "^4.7.10",
    "ts-morph": "^28.0.0"
  }
}
