{
  "name": "nestjs-api-bridge-vscode",
  "displayName": "NestJS API Bridge",
  "description": "Explora los endpoints de tu API NestJS y genera clientes Angular y Flutter.",
  "version": "0.0.1",
  "private": true,
  "publisher": "javiermorenodev",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.controller.ts"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "nestjsApiBridge.endpoints",
          "name": "NestJS Endpoints"
        }
      ]
    },
    "commands": [
      {
        "command": "nestjsApiBridge.openHandler",
        "title": "Abrir endpoint",
        "icon": "$(go-to-file)"
      },
      {
        "command": "nestjsApiBridge.copyUrl",
        "title": "Copiar URL",
        "icon": "$(link)"
      },
      {
        "command": "nestjsApiBridge.copyCurl",
        "title": "Copiar como cURL",
        "icon": "$(clippy)"
      },
      {
        "command": "nestjsApiBridge.generateAngular",
        "title": "Generar servicio Angular",
        "icon": "$(file-code)"
      },
      {
        "command": "nestjsApiBridge.generateFlutter",
        "title": "Generar cliente Flutter",
        "icon": "$(file-code)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "nestjsApiBridge.openHandler",
          "when": "view == nestjsApiBridge.endpoints && viewItem == nestjsEndpoint",
          "group": "navigation@1"
        },
        {
          "command": "nestjsApiBridge.copyUrl",
          "when": "view == nestjsApiBridge.endpoints && viewItem == nestjsEndpoint",
          "group": "1_copy@1"
        },
        {
          "command": "nestjsApiBridge.copyCurl",
          "when": "view == nestjsApiBridge.endpoints && viewItem == nestjsEndpoint",
          "group": "1_copy@2"
        },
        {
          "command": "nestjsApiBridge.generateAngular",
          "when": "view == nestjsApiBridge.endpoints && viewItem == nestjsEndpoint",
          "group": "2_generate@1"
        },
        {
          "command": "nestjsApiBridge.generateFlutter",
          "when": "view == nestjsApiBridge.endpoints && viewItem == nestjsEndpoint",
          "group": "2_generate@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf out"
  },
  "dependencies": {
    "@nestjs-api-bridge/core": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0"
  }
}
